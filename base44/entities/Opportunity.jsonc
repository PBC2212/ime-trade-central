{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "description": "Ticker symbol"
    },
    "direction": {
      "type": "string",
      "enum": [
        "long",
        "short"
      ],
      "description": "Trade direction"
    },
    "sector": {
      "type": "string",
      "description": "Market sector"
    },
    "strategy_type": {
      "type": "string",
      "enum": [
        "momentum",
        "breakout",
        "mean_reversion",
        "trend_continuation",
        "volume_anomaly"
      ],
      "description": "Strategy type"
    },
    "time_horizon": {
      "type": "string",
      "enum": [
        "intraday",
        "swing",
        "position",
        "long_term"
      ],
      "description": "Time horizon"
    },
    "entry_price": {
      "type": "number",
      "description": "Recommended entry price"
    },
    "stop_loss": {
      "type": "number",
      "description": "Stop loss price"
    },
    "target_price": {
      "type": "number",
      "description": "Target 1 price"
    },
    "target_price_2": {
      "type": "number",
      "description": "Target 2 price"
    },
    "risk_reward_ratio": {
      "type": "number",
      "description": "Risk/reward ratio"
    },
    "confidence_score": {
      "type": "number",
      "description": "AI confidence 0-100"
    },
    "risk_score": {
      "type": "number",
      "description": "Risk score 0-100"
    },
    "reward_score": {
      "type": "number",
      "description": "Reward score 0-100"
    },
    "institutional_quality_score": {
      "type": "number",
      "description": "Institutional quality score 0-100"
    },
    "position_sizing": {
      "type": "string",
      "description": "Position sizing recommendation"
    },
    "primary_catalyst": {
      "type": "string",
      "description": "Primary catalyst driving the trade"
    },
    "institutional_thesis": {
      "type": "string",
      "description": "Full institutional thesis"
    },
    "ai_explanation": {
      "type": "string",
      "description": "AI reasoning for the trade"
    },
    "liquidity_score": {
      "type": "number",
      "description": "Liquidity score 0-100"
    },
    "relative_strength_score": {
      "type": "number",
      "description": "Relative strength score 0-100"
    },
    "technical_indicators": {
      "type": "object",
      "description": "Key technical indicators"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "triggered",
        "stopped",
        "target_hit",
        "expired"
      ],
      "default": "active"
    }
  },
  "required": [
    "symbol",
    "direction",
    "confidence_score"
  ]
}