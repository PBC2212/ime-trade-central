{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "trader"
      ],
      "default": "trader"
    },
    "portfolio_equity": {
      "type": "number",
      "default": 100000
    },
    "risk_tolerance": {
      "type": "string",
      "enum": [
        "conservative",
        "moderate",
        "aggressive"
      ],
      "default": "moderate"
    },
    "preferred_sectors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_position_size": {
      "type": "number",
      "default": 2
    },
    "alpaca_api_key": {
      "type": "string",
      "description": "User's Alpaca API key ID for per-account trading"
    },
    "alpaca_secret_key": {
      "type": "string",
      "description": "User's Alpaca API secret key for per-account trading"
    },
    "alpaca_base_url": {
      "type": "string",
      "default": "https://paper-api.alpaca.markets",
      "description": "Alpaca API base URL (paper or live)"
    }
  }
}